{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/**",
              "components/icons/**",
              "ui_kits/mentorship/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Inter, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='Approval'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Approval> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|type|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, style, text, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:dot|text)$/]",
        "message": "<Badge> type must be one of 'dot' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryDark'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|status|level|key|ref|className|style|children)$/]",
        "message": "<BatteryDark> doesn't accept that prop. Declared props: className, style, status, level."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryDark'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:normal|charging)$/]",
        "message": "<BatteryDark> status must be one of 'normal' | 'charging'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BatteryDark'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:10|100|50)$/]",
        "message": "<BatteryDark> level must be one of '10' | '100' | '50'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon|label|size|shape|type|contentType|loading|state|skeleton|disabled|icon1|key|ref|className|style|children)$/]",
        "message": "<BrandButton> doesn't accept that prop. Declared props: className, style, icon, label, size, shape, type, contentType, loading, state, skeleton, disabled, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm)$/]",
        "message": "<BrandButton> size must be one of 'lg' | 'md' | 'sm'."
